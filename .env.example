# AI Omnichannel Sales OS Web — Environment Configuration
# Copy to .env.local for local development.
# NEVER commit .env.local or any file with real values.

# Backend JSON API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Development bearer token for the WEB API (matches backend WEB_API_DEV_TOKEN)
NEXT_PUBLIC_API_TOKEN=dev-token
